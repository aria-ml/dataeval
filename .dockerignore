# =============================================================================
# Docker build context — only what docker/Dockerfile.<variant> actually COPYs:
#   pyproject.toml, uv.lock, README.md, src/, docker/smoke.py
#
# Everything else is excluded. Keeping the context minimal is not just about
# build speed: each unnecessary file is another way for local state to end up
# baked into a published image.
# =============================================================================

# Version control. The build is hermetic — hatch-vcs is fed
# SETUPTOOLS_SCM_PRETEND_VERSION rather than reading tags from .git.
.git
.gitattributes
.gitignore
.github
.gitlab
.gitlab-ci.yml

# Docker config itself; the smoke test is the one file the image needs.
docker/
!docker/smoke.py

# Generated by the hatch-vcs build hook. Excluding it keeps a stale local copy
# from shadowing the version resolved for this build.
src/dataeval/_version.py

# Python artifacts
.venv
.nox
.tox
**/build
**/__pycache__
**/*.pyc
**/*.pyo
*.egg-info
.coverage
.pytest_cache
.ruff_cache
.numba-cache
.jupyter_cache

# IDE and tooling
.claude
.devcontainer
.vscode
.idea
*.swp
*.swo

# Environment and secrets
.env
.env.*
cosign.key

# Documentation, specs and metadata (not needed at runtime)
docs/
specs/
scripts/
tests/
verification/
prototype/
LICENSE
*.md
!README.md

# Build and test output
output/
htmlcov

# Exported dependency files — the image installs from uv.lock, not these.
requirements.*.txt
environment.yml

# Misc
.cuda-version
noxfile.py
