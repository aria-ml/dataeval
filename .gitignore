*venv*/
__pycache__/
dist/

data/
!src/dataeval/data
!src/dataeval/utils/data
!tests/data
!tests/utils/data

docs/build/
docs/source/reference/autoapi
docs/source/tutorials/notebooks/checkpoints/

# Intersphinx inventories pre-fetched by docs/fetch-intersphinx-inventories.py
# (cached in CI, keyed on docs/source/conf.py)
docs/source/_intersphinx/

# Jupyter cache is stored in orphan branches (docs-artifacts/<branch>)
# See scripts/README.md for details
.jupyter_cache/

# IPython runtime files and configuration
docs/source/.ipython/*
!docs/source/.ipython/profile_default/
docs/source/.ipython/profile_default/*
!docs/source/.ipython/profile_default/ipython_kernel_config.py

# Generated notebook files - stored in docs-artifacts branches for Colab
docs/source/notebooks/*.ipynb

output/
.coverage*

.tox/
.nox/
.numba-cache/
.python-version
.cuda-version

# Used to store user customizable settings
.settings
# debug profiles
.vscode/launch.json

# Autogenerated version file
src/dataeval/_version.py

# Vulnerability scan report, produced by CI between the `prod` and `scanned`
# image builds and copied into the published image. Never committed: it
# describes one build of one variant, and a stale copy in the tree would be
# baked into an image it does not describe.
docker/security/
